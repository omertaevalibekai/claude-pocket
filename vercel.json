{
  "rewrites": [
    {
      "source": "/event",
      "destination": "/api/pocket?route=event"
    },
    {
      "source": "/state",
      "destination": "/api/pocket?route=state"
    },
    {
      "source": "/widget.js",
      "destination": "/api/pocket?route=widget.js"
    },
    {
      "source": "/health",
      "destination": "/api/pocket?route=health"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
